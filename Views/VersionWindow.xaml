<Window x:Class="ClipInspect.Views.VersionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="バージョン情報" Width="720" Height="560" MinWidth="520" MinHeight="400"
        FontFamily="{StaticResource UiFont}" FontSize="13"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" ResizeMode="CanResize">
  <DockPanel Margin="12">
    <StackPanel DockPanel.Dock="Top">
      <TextBlock x:Name="VersionText" FontSize="18" FontWeight="Bold" />
      <TextBlock Text="© ja1bus" Margin="0,2,0,8" />
      <TextBlock TextWrapping="Wrap" Margin="0,0,0,8"
                 Text="ClipInspect はインターネットに接続しません。クリップボードの内容・取得結果・設定をファイルに保存しません（取得結果はアプリを終了すると破棄されます）。" />
      <TextBlock Text="MIT License" FontWeight="Bold" />
      <TextBox IsReadOnly="True" BorderThickness="0" Background="Transparent" FontFamily="{StaticResource MonoFont}"
               Text="https://github.com/ja1bus/ClipInspect" Margin="0,2,0,8"
               ToolTip="選択してコピーできます（ブラウザーは開きません）" />
      <WrapPanel Margin="0,0,0,6">
        <RadioButton x:Name="ShowLicense" Content="LICENSE" IsChecked="True" Margin="0,0,16,0" Checked="Which_Changed" />
        <RadioButton x:Name="ShowNotices" Content="THIRD-PARTY-NOTICES" Checked="Which_Changed" />
      </WrapPanel>
    </StackPanel>
    <Button DockPanel.Dock="Bottom" Content="閉じる" HorizontalAlignment="Right" Padding="16,4" Margin="0,8,0,0" IsCancel="True" IsDefault="True" Click="Close_Click" />
    <TextBox x:Name="LicenseText" IsReadOnly="True" FontFamily="{StaticResource MonoFont}" TextWrapping="Wrap"
             VerticalScrollBarVisibility="Auto" />
  </DockPanel>
</Window>
